# Профиль D: 1.5B — только автодополнение (FIM), живёт рядом с 14B.
# 1 ГБ веса + ~0.2 ГБ KV. 14B(9) + 1.5B(1) = 10 ГБ, влезает в 12 ГБ вместе.
# Для чата не использовать: слишком слабая.
# Скорость: 100+ ток/с, подсказка приходит за ~0.2-0.5 с.

FROM qwen2.5-coder:1.5b

PARAMETER num_ctx 4096
PARAMETER num_gpu 99
PARAMETER temperature 0.1
