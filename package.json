{
  "name": "3060-ollama-cline-opencode",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Offline coding-agent kit for RTX 3060: task selection, local/cloud switching and route (snapshot of SwiftMatch scripts)",
  "scripts": {
    "test": "vitest run scripts/next-task.test.mjs scripts/ai-profile.test.mjs scripts/project-brief.test.mjs scripts/backlog.test.mjs scripts/agent-eval.test.mjs scripts/agent-live.test.mjs scripts/init-project.test.mjs scripts/retention-gate.test.mjs scripts/stage-section.test.mjs scripts/symbols.test.mjs",
    "test:retent": "vitest run scripts/retention-gate.test.mjs",
    "test:section": "vitest run scripts/stage-section.test.mjs",
    "stage:section": "node scripts/stage-section.mjs",
    "test:next": "vitest run scripts/next-task.test.mjs",
    "test:ai": "vitest run scripts/ai-profile.test.mjs",
    "test:brief": "vitest run scripts/project-brief.test.mjs",
    "test:backlog": "vitest run scripts/backlog.test.mjs",
    "test:eval": "vitest run scripts/agent-eval.test.mjs",
    "test:live": "vitest run scripts/agent-live.test.mjs",
    "test:init": "vitest run scripts/init-project.test.mjs",
    "test:symbols": "vitest run scripts/symbols.test.mjs",
    "symbols": "node scripts/symbols.mjs",
    "init:project": "node scripts/init-project.mjs",
    "check:backlog": "node scripts/backlog.mjs check",
    "docs:map": "node scripts/doc-map.mjs",
    "docs:check": "node scripts/doc-map.mjs --check",
    "retent:check": "node scripts/retention-gate.mjs",
    "retent:check:preflight": "node scripts/retention-gate.mjs --preflight",
    "backlog:open": "node scripts/backlog.mjs open",
    "backlog:close": "node scripts/backlog.mjs close",
    "eval:list": "node scripts/agent-eval.mjs list",
    "eval:prompt": "node scripts/agent-eval.mjs prompt",
    "eval:record": "node scripts/agent-eval.mjs record",
    "eval:score": "node scripts/agent-eval.mjs score",
    "eval:live": "node scripts/agent-live.mjs"
  },
  "devDependencies": {
    "vitest": "^3.2.6"
  }
}
